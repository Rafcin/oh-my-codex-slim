{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Rafcin/oh-my-codex-slim/main/schema/omcs.schema.json",
  "title": "OMCS configuration",
  "description": "Version-one OMCS policy configuration. Credentials, provider settings, model-account choices, tokens, and command paths are not valid configuration fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "description": "The OMCS configuration schema version.",
      "const": 1
    },
    "profile": {
      "description": "Execution profile. Model or provider selections are not configuration fields.",
      "enum": ["auto", "fast", "thorough", "council"]
    },
    "$schema": {
      "description": "The fixed public schema URL. Credentials and model-account choices are not configuration fields.",
      "const": "https://raw.githubusercontent.com/Rafcin/oh-my-codex-slim/main/schema/omcs.schema.json"
    },
    "approval": {
      "description": "The approval policy for material decisions.",
      "const": "material-decisions"
    },
    "quality": {
      "description": "Risk-adaptive quality gates.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clarification": { "const": "adaptive" },
        "design": { "const": "adaptive" },
        "tdd": { "const": "adaptive" },
        "review": { "const": "risk-gated" },
        "antiSlop": { "const": "changed-files" }
      }
    },
    "orchestration": {
      "description": "Bounded native-agent orchestration settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallel": { "const": 2 },
        "council": { "const": "explicit-only" }
      }
    }
  }
}
